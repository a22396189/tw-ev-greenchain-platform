{
  "uid": "greenchain-business",
  "title": "EV & Green-Energy Supply-Chain Analytics",
  "tags": [
    "green-energy",
    "ev",
    "business"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Companies tracked",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT COUNT(*) AS value FROM supply_chain_company",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Sub-sectors",
      "type": "stat",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT COUNT(DISTINCT SubSector) AS value FROM supply_chain_company",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Latest fully-reported revenue month",
      "type": "table",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT (SELECT Month FROM monthly_revenue GROUP BY Month HAVING COUNT(*) >= 10 ORDER BY Month DESC LIMIT 1) AS `Month`",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Basket avg return, ~60 trading rows",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "WITH ranked AS (SELECT StockID, Close, ROW_NUMBER() OVER (PARTITION BY StockID ORDER BY Date DESC) rn FROM stock_price WHERE Close IS NOT NULL) SELECT ROUND(AVG((a.Close/b.Close-1)*100),2) AS value FROM (SELECT StockID, Close FROM ranked WHERE rn=1) a JOIN (SELECT StockID, Close FROM ranked WHERE rn=60) b ON a.StockID=b.StockID",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Latest-month revenue by sub-sector (thousand NTD)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT c.SubSector AS metric, SUM(r.RevenueThousandNTD) AS value FROM monthly_revenue r JOIN supply_chain_company c ON r.StockID=c.StockID WHERE r.Month=(SELECT Month FROM monthly_revenue GROUP BY Month HAVING COUNT(*) >= 10 ORDER BY Month DESC LIMIT 1) GROUP BY c.SubSector ORDER BY value DESC",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Sub-sector revenue-weighted YoY % (momentum)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT STR_TO_DATE(CONCAT(r.Month,'-01'),'%Y-%m-%d') AS time, c.SubSector AS metric, SUM(r.RevenueThousandNTD*r.YoYPct)/NULLIF(SUM(r.RevenueThousandNTD),0) AS value FROM monthly_revenue r JOIN supply_chain_company c ON r.StockID=c.StockID WHERE r.YoYPct IS NOT NULL AND r.Month IN (SELECT Month FROM monthly_revenue GROUP BY Month HAVING COUNT(*) >= 10) GROUP BY r.Month, c.SubSector ORDER BY time",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "timeFrom": "18M"
    },
    {
      "id": 7,
      "title": "Share price rebased to 100 (per company)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT p.Date AS time, c.CompanyName AS metric, p.Close / FIRST_VALUE(p.Close) OVER (PARTITION BY p.StockID ORDER BY p.Date) * 100 AS value FROM stock_price p JOIN supply_chain_company c ON p.StockID=c.StockID WHERE p.Close IS NOT NULL ORDER BY time",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "timeFrom": "1y"
    },
    {
      "id": 8,
      "title": "Operating margin % by company (quarterly)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT STR_TO_DATE(CONCAT(q.Year,'-',(q.Quarter-1)*3+1,'-01'),'%Y-%m-%d') AS time, c.CompanyName AS metric, q.OperatingMarginPct AS value FROM quarterly_margins q JOIN supply_chain_company c ON q.StockID=c.StockID ORDER BY time",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "timeFrom": "2y"
    },
    {
      "id": 9,
      "title": "Trailing return leaderboard (60 trading rows)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "WITH ranked AS (SELECT StockID, Close, ROW_NUMBER() OVER (PARTITION BY StockID ORDER BY Date DESC) rn FROM stock_price WHERE Close IS NOT NULL) SELECT c.CompanyName AS `Company`, c.SubSector AS `Sub-sector`, ROUND((a.Close/b.Close-1)*100,2) AS `Return %` FROM (SELECT StockID, Close FROM ranked WHERE rn=1) a JOIN (SELECT StockID, Close FROM ranked WHERE rn=60) b ON a.StockID=b.StockID JOIN supply_chain_company c ON a.StockID=c.StockID ORDER BY `Return %` DESC",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Three-institution net buy, shares (per company)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT i.Date AS time, c.CompanyName AS metric, i.ThreeInstitutionNet AS value FROM institutional_investor i JOIN supply_chain_company c ON i.StockID=c.StockID ORDER BY time",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Taiwan energy-transition targets (ILLUSTRATIVE - verify each SourceURL)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-greenchain"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-greenchain"
          },
          "rawSql": "SELECT Year, MetricLabel AS `Metric`, TargetValue AS `Target`, ActualValue AS `Actual`, Unit, Note, SourceURL AS `Source` FROM green_energy_targets ORDER BY Year, Metric",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}